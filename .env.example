# 环境配置
NODE_ENV=production

# 服务器配置
PORT=3031
MODE=sse  # 可选: stdio, sse, rest

# 翻译 API 配置（必需）
# 智谱 AI 示例（推荐）：
TRANSLATION_API_KEY=your-zhipu-api-key
TRANSLATION_MODEL=glm-4.5-air
TRANSLATION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenRouter 示例：
# TRANSLATION_API_KEY=sk-or-v1-xxxxxxxxxxxxx
# TRANSLATION_MODEL=anthropic/claude-3.5-sonnet
# TRANSLATION_BASE_URL=https://openrouter.ai/api/v1

# OpenAI 示例：
# TRANSLATION_API_KEY=sk-xxxxxxxxxxxxx
# TRANSLATION_MODEL=gpt-4-turbo
# TRANSLATION_BASE_URL=https://api.openai.com/v1

# DeepSeek 示例：
# TRANSLATION_API_KEY=sk-xxxxxxxxxxxxx
# TRANSLATION_MODEL=deepseek-chat
# TRANSLATION_BASE_URL=https://api.deepseek.com/v1

# Docker Compose 特定配置（仅用于 docker-compose.yml）
# 注意：PORT 变量在 compose 中用于端口映射
# MCP_PORT=3031  # 已废弃，使用 PORT 代替
