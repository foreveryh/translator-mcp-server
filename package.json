{
  "name": "translator-mcp-server",
  "version": "0.1.0",
  "main": "dist/index.js",
  "bin": {
    "translator-mcp": "dist/index.js"
  },
  "description": "Professional translation MCP server with three-stage workflow, supporting multiple languages and AI providers",
  "license": "Apache-2.0",
  "author": "foreveryh",
  "repository": {
    "type": "git",
    "url": "https://github.com/foreveryh/translator-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "translation",
    "translator",
    "openai",
